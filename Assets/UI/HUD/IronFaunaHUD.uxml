<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:Style src="IronFaunaHUD.uss" />
  <ui:VisualElement name="hudRoot" class="hud-root" picking-mode="Ignore">
    <ui:VisualElement name="topBar" class="top-bar" picking-mode="Ignore">
      <ui:VisualElement name="statusCard" class="status-card">
        <ui:Label name="titleLabel" text="IRONFAUNA // TACTICAL TELEMETRY" class="title-text" />
        <ui:Label name="objectiveHpLabel" text="OBJECTIVE CORE HP: 500 / 500" class="accent-cyan" />
        <ui:Label name="creditsLabel" text="CREDITS: 300 CR" class="stat-text" />
        <ui:Label name="activeRobotLabel" text="PILOTING: HeroMech_HumanoidClamshell" class="stat-text" />
        <ui:Label name="activePoseLabel" text="KNEE PIVOT POSE: Pose1_HumanLeg" class="stat-text" />
      </ui:VisualElement>

      <ui:VisualElement name="optionsCard" class="options-card">
        <ui:Label name="optionsHeaderLabel" text="CONTROL SCHEME &amp; ROBOT OPTIONS" class="title-text" />
        <ui:Label name="detectedDeviceLabel" text="ACTIVE INPUT: KEYBOARD &amp; MOUSE" class="accent-cyan" />
        <ui:VisualElement name="schemeButtonRow" class="button-row">
          <ui:Button name="btnAutoScheme" text="AUTO" class="scheme-button scheme-button-active" />
          <ui:Button name="btnKbmScheme" text="KB + MOUSE" class="scheme-button" />
          <ui:Button name="btnPs5Scheme" text="PS5 DUALSENSE" class="scheme-button" />
          <ui:Button name="btnXboxScheme" text="XBOX PAD" class="scheme-button" />
        </ui:VisualElement>
        <ui:VisualElement name="robotActionRow" class="button-row">
          <ui:Button name="btnSwapRobot" text="SWAP ROBOT (TAB / Y / TRIANGLE)" class="action-button" />
          <ui:Button name="btnCyclePose" text="CYCLE KNEE PIVOT (E / D-PAD)" class="action-button" />
          <ui:Button name="btnInvertY" text="INVERT Y: OFF" class="action-button" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="bottomBar" class="bottom-bar">
      <ui:Label name="bindingPromptsLabel" text="KEYBOARD &amp; MOUSE: [WASD] Move · [Hold RMB] Orbit Camera · [Shift] Boost · [Space] Jump · [LMB] Railgun · [F] Saw-Slash · [Q/E] Knee Pivot Pose · [1/2] Wall/Turret · [Tab] Swap Robot" class="prompts-text" />
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>
